  }
};
</script>
<style>
body {
  font-family: Inter, Arial, sans-serif;
  background: #0b0f19;
  color: #f3f4f6;
}
input[type=range] { accent-color: #38bdf8; width:100%; }
canvas { display:block; width:100%; height:100%; }
