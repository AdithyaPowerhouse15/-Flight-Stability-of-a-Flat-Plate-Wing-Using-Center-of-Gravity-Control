<!DOCTYPE html>
<html lang="en" class="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Flat-Plate Wing Flight Stability Simulator</title>
<script src="https://cdn.tailwindcss.com"></script>
<script>
tailwind.config = {
  darkMode: 'class',
  theme: {
    extend: {
      colors: {
        aerospace: {
          900: '#0b0f19',
          800: '#111827',
          700: '#1f2937',
          accent: '#38bdf8'
        }
      }
    }
  }
};
</script>
<style>
body {
  font-family: Inter, Arial, sans-serif;
  background: #0b0f19;
  color: #f3f4f6;
}
input[type=range] { accent-color: #38bdf8; width: 100%; cursor: pointer; }
.panel {
  background: #111827;
  border: 1px solid #1f2937;
  border-radius: 16px;
  padding: 18px;
}
.metric {
  background: #0b0f19;
  border: 1px solid #374151;
  border-radius: 12px;
  padding: 12px;
}
</style>
</head>

<body class="min-h-screen pb-10">

<header class="bg-aerospace-800 border-b border-slate-700 p-5 flex flex-wrap justify-between items-center gap-4">
  <div>
    <h1 class="text-xl font-bold text-white">Flat-Plate Wing Flight Stability Simulator</h1>
    <p class="text-xs text-slate-400 mt-1">Aerodynamics & CG Control | Square Diamond Configuration</p>
  </div>
  <div class="flex flex-wrap gap-2">
    <button onclick="setPreset('stable')" class="bg-emerald-600/30 text-emerald-300 border border-emerald-500 hover:bg-emerald-600/50 rounded-lg px-3 py-2 text-xs font-medium cursor-pointer">Stable Preset</button>
    <button onclick="setPreset('neutral')" class="bg-amber-600/30 text-amber-300 border border-amber-500 hover:bg-amber-600/50 rounded-lg px-3 py-2 text-xs font-medium cursor-pointer">Neutral Preset</button>
    <button onclick="setPreset('unstable')" class="bg-rose-600/30 text-rose-300 border border-rose-500 hover:bg-rose-600/50 rounded-lg px-3 py-2 text-xs font-medium cursor-pointer">Unstable Preset</button>
    <button onclick="resetSimulation()" class="bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-lg px-3 py-2 text-xs font-medium cursor-pointer">Reset</button>
  </div>
</header>

<main class="max-w-[1600px] mx-auto p-4 grid grid-cols-1 lg:grid-cols-12 gap-5">

<!-- CONTROLS & TELEMETRY SECTION -->
<section class="lg:col-span-5 space-y-5">

<div class="panel shadow-xl">
  <div class="flex justify-between items-center mb-5">
    <h2 class="text-sm font-bold uppercase text-sky-400">Flight & Mass Parameters</h2>
    <span id="modeBadge" class="text-xs rounded-full px-3 py-1 bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-semibold">Stable CG</span>
  </div>

  <div class="space-y-4">
    <div>
      <div class="flex justify-between text-xs mb-1">
        <label class="text-slate-300">Ballast Mass (added mass)</label>
        <span id="ballastVal" class="text-sky-400 font-mono font-bold">200 g</span>
      </div>
      <input id="ballastInput" type="range" min="0" max="300" step="10" value="200">
    </div>

    <div>
      <div class="flex justify-between text-xs mb-1">
        <label class="text-slate-300">CG Position Relative to AC</label>
        <span id="cgVal" class="text-sky-400 font-mono font-bold">+35 mm</span>
      </div>
      <input id="cgInput" type="range" min="-30" max="60" step="1" value="35">
      <div class="flex justify-between text-[10px] text-slate-500 mt-1">
        <span>-30mm: Aft (Unstable)</span>
        <span>0: AC</span>
        <span>+60mm: Fwd (Stable)</span>
      </div>
    </div>

    <div>
      <div class="flex justify-between text-xs mb-1">
        <label class="text-slate-300">Launch Angle of Attack (AoA)</label>
        <span id="aoaVal" class="text-sky-400 font-mono font-bold">5.0°</span>
      </div>
      <input id="aoaInput" type="range" min="-5" max="25" step="0.5" value="5">
    </div>

    <div>
      <div class="flex justify-between text-xs mb-1">
        <label class="text-slate-300">Initial Airspeed</label>
        <span id="speedVal" class="text-sky-400 font-mono font-bold">12.0 m/s</span>
      </div>
      <input id="speedInput" type="range" min="5" max="25" step="0.5" value="12">
    </div>
  </div>

  <div class="grid grid-cols-2 gap-3 mt-6">
    <button onclick="resetSimulation()" class="bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold rounded-xl py-3 text-sm cursor-pointer shadow-lg shadow-sky-500/20 transition-all">▶ Launch / Reset</button>
    <button onclick="togglePause()" id="pauseBtn" class="bg-slate-700 hover:bg-slate-600 text-slate-200 font-semibold rounded-xl py-3 text-sm cursor-pointer transition-all">Pause</button>
  </div>
</div>

<div class="panel shadow-xl">
  <h3 class="text-xs uppercase font-bold text-slate-400 mb-3 tracking-wider">Live Telemetry</h3>
  <div class="grid grid-cols-2 gap-3">
    <div class="metric"><span class="text-[11px] text-slate-400">Pitch Angle</span><div id="telePitch" class="text-lg font-mono text-white mt-1">5.0°</div></div>
    <div class="metric"><span class="text-[11px] text-slate-400">Altitude</span><div id="teleAlt" class="text-lg font-mono text-sky-400 mt-1">10.00 m</div></div>
    <div class="metric"><span class="text-[11px] text-slate-400">Lift Force</span><div id="teleLift" class="text-lg font-mono text-emerald-400 mt-1">0.00 N</div></div>
    <div class="metric"><span class="text-[11px] text-slate-400">Pitch Moment</span><div id="teleMoment" class="text-lg font-mono text-amber-400 mt-1">0.000 Nm</div></div>
    <div class="metric"><span class="text-[11px] text-slate-400">Airspeed</span><div id="teleSpeed" class="text-lg font-mono text-white mt-1">12.0 m/s</div></div>
    <div class="metric"><span class="text-[11px] text-slate-400">Angle of Attack</span><div id="teleAlpha" class="text-lg font-mono text-white mt-1">5.0°</div></div>
  </div>
</div>

<div class="panel shadow-xl">
  <h3 class="text-xs uppercase font-bold text-sky-400 mb-2 tracking-wider">Aerodynamic Theory Insight</h3>
  <p id="theoryText" class="text-xs text-slate-300 leading-relaxed">
    With the CG positioned ahead of the Aerodynamic Center (AC), an increase in angle of attack generates a restoring nose-down pitching moment, providing positive longitudinal static stability.
  </p>
</div>

</section>

<!-- VISUALIZER & CHARTS SECTION -->
<section class="lg:col-span-7 space-y-5">

<div class="panel shadow-xl">
  <div class="flex justify-between items-center mb-3">
    <h3 class="text-xs uppercase font-bold text-slate-400 tracking-wider">Square Diamond Wing Visualizer</h3>
    <div class="text-xs space-x-3"><span class="text-sky-400 font-medium">● AC (1/4 MAC)</span> <span class="text-rose-400 font-medium">● CG</span></div>
  </div>
  <div class="relative h-[360px] bg-aerospace-900 rounded-xl overflow-hidden border border-slate-700">
    <canvas id="simCanvas" class="w-full h-full"></canvas>
    <div class="absolute top-3 left-3 bg-slate-900/90 border border-slate-700/60 rounded-lg px-3 py-2 text-xs font-mono shadow-md">
      Flight Time: <span id="hudTime" class="text-sky-400 font-bold">0.00 s</span><br>
      Downrange: <span id="hudDist" class="text-emerald-400 font-bold">0.0 m</span>
    </div>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
  <div class="panel shadow-xl">
    <h3 class="text-xs uppercase font-bold text-slate-400 mb-2 tracking-wider">Pitch Angle vs Time</h3>
    <div class="h-32 bg-slate-950 rounded-lg overflow-hidden border border-slate-800 relative">
      <canvas id="pitchCanvas" class="w-full h-full"></canvas>
    </div>
  </div>
  <div class="panel shadow-xl">
    <h3 class="text-xs uppercase font-bold text-slate-400 mb-2 tracking-wider">Flight Trajectory (Alt vs Range)</h3>
    <div class="h-32 bg-slate-950 rounded-lg overflow-hidden border border-slate-800 relative">
      <canvas id="trajCanvas" class="w-full h-full"></canvas>
    </div>
  </div>
</div>

<div class="panel shadow-xl">
  <div class="flex justify-between items-center">
    <div>
      <h3 class="text-xs uppercase font-bold text-slate-400 tracking-wider">Simulation Status</h3>
      <p id="statusMsg" class="text-sm font-semibold text-emerald-400 mt-1">Ready for flight. Adjust parameters or launch.</p>
    </div>
    <div class="text-right">
      <span class="text-[10px] text-slate-500 uppercase block">Aircraft Model</span>
      <span class="text-xs text-slate-300 font-mono">1m x 1m Styrofoam Diamond Wing (~545g total)</span>
    </div>
  </div>
</div>

</section>
</main>

<script>
'use strict';

const MODEL = {
  rho: 1.225,          // Air density (kg/m^3)
  gravity: 9.81,       // Gravitational acceleration (m/s^2)
  area: 0.98,          // Wing reference area (m^2)
  chord: 1.41,         // Mean Aerodynamic Chord / Diagonal (m)
  baseMass: 0.345,     // Airframe base mass (kg)
  inertia: 0.08,       // Pitch moment of inertia (kg m^2)
  cmAC: 0.0,           // Pitching moment coefficient at AC
  cmQ: -6.5,           // Pitch damping derivative
  cd0: 0.07,           // Zero-lift drag coefficient
  dt: 1 / 120          // Simulation fixed timestep
};

const state = {
  ballast: 200,        // grams
  cgOffset: 35,        // mm ahead of AC
  aoa: 5.0,            // degrees
  speed: 12.0,         // m/s

  x: 0,                // Downrange distance (m)
  y: 10,               // Altitude (m)
  vx: 12,              // Horizontal velocity (m/s)
  vy: 0,               // Vertical velocity (m/s)

  pitch: 5 * Math.PI / 180, // Radians
  pitchRate: 0.0,      // rad/s

  time: 0,
  paused: false,
  landed: false,

  lift: 0,
  drag: 0,
  moment: 0,
  alpha: 0,

  history: []
};

// DOM Element references
const $ = id => document.getElementById(id);

const ballastInput = $('ballastInput');
const cgInput = $('cgInput');
const aoaInput = $('aoaInput');
const speedInput = $('speedInput');

const simCanvas = $('simCanvas');
const pitchCanvas = $('pitchCanvas');
const trajCanvas = $('trajCanvas');

const simCtx = simCanvas.getContext('2d');
const pitchCtx = pitchCanvas.getContext('2d');
const trajCtx = trajCanvas.getContext('2d');

function setupCanvasResolutions() {
  [simCanvas, pitchCanvas, trajCanvas].forEach(canvas => {
    const rect = canvas.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;
    canvas.width = Math.round(rect.width * dpr);
    canvas.height = Math.round(rect.height * dpr);
    const ctx = canvas.getContext('2d');
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  });
}

function readInputs() {
  state.ballast = Number(ballastInput.value);
  state.cgOffset = Number(cgInput.value);
  state.aoa = Number(aoaInput.value);
  state.speed = Number(speedInput.value);

  $('ballastVal').textContent = state.ballast + ' g';
  $('cgVal').textContent = (state.cgOffset > 0 ? '+' : '') + state.cgOffset + ' mm';
  $('aoaVal').textContent = state.aoa.toFixed(1) + '°';
  $('speedVal').textContent = state.speed.toFixed(1) + ' m/s';

  updateModeBadge();
}

function updateModeBadge() {
  const badge = $('modeBadge');
  const theory = $('theoryText');

  if (state.cgOffset > 5) {
    badge.textContent = 'Stable CG';
    badge.className = 'text-xs rounded-full px-3 py-1 bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-semibold';
    theory.textContent = 'With the CG well ahead of the Aerodynamic Center (AC), an increase in angle of attack produces a restoring nose-down pitching moment. This provides positive longitudinal static stability, enabling a steady glide path.';
  } else if (state.cgOffset < -5) {
    badge.textContent = 'Unstable CG';
    badge.className = 'text-xs rounded-full px-3 py-1 bg-rose-500/20 text-rose-300 border border-rose-500/30 font-semibold';
    theory.textContent = 'With the CG behind the Aerodynamic Center, any pitch disturbance is amplified. This results in pitch instability, nose-up stalls, or rapid loss of altitude and control.';
  } else {
    badge.textContent = 'Neutral CG';
    badge.className = 'text-xs rounded-full px-3 py-1 bg-amber-500/20 text-amber-300 border border-amber-500/30 font-semibold';
    theory.textContent = 'With the CG coincident with the AC, the static restoring pitching moment is zero. Flight behavior is highly sensitive to disturbances and damping.';
  }
}

function setPreset(type) {
  if (type === 'stable') {
    ballastInput.value = 200;
    cgInput.value = 35;
    aoaInput.value = 5.0;
    speedInput.value = 12.0;
  } else if (type === 'neutral') {
    ballastInput.value = 100;
    cgInput.value = 0;
    aoaInput.value = 5.0;
    speedInput.value = 12.0;
  } else if (type === 'unstable') {
    ballastInput.value = 0;
    cgInput.value = -15;
    aoaInput.value = 6.0;
    speedInput.value = 11.0;
  }
  readInputs();
  resetSimulation();
}

// Attach listener events to inputs for real-time reactivity
[ballastInput, cgInput, aoaInput, speedInput].forEach(elem => {
  elem.addEventListener('input', () => {
    readInputs();
  });
});

function resetSimulation() {
  readInputs();
  state.x = 0;
  state.y = 10;
  state.vx = state.speed;
  state.vy = 0;
  state.pitch = state.aoa * Math.PI / 180;
  state.pitchRate = 0;
  state.time = 0;
  state.landed = false;
  state.paused = false;

  state.history = [{ time: 0, pitch: state.aoa, x: 0, y: 10 }];

  $('pauseBtn').textContent = 'Pause';
  $('statusMsg').textContent = 'Simulation running...';
  $('statusMsg').className = 'text-sm font-semibold text-emerald-400 mt-1';
}

function togglePause() {
  if (state.landed) return;
  state.paused = !state.paused;
  $('pauseBtn').textContent = state.paused ? 'Resume' : 'Pause';
  $('statusMsg').textContent = state.paused ? 'Simulation paused' : 'Simulation running...';
}

// Aerodynamic calculations
function computeAerodynamics() {
  const speed = Math.max(0.1, Math.hypot(state.vx, state.vy));
  const flightPathAngle = Math.atan2(state.vy, state.vx);
  const alpha = state.pitch - flightPathAngle; // Angle of attack

  const sinA = Math.sin(alpha);
  const cosA = Math.cos(alpha);

  // Flat plate aerodynamics approximation
  const CL = 1.9 * sinA * cosA;
  const CD = MODEL.cd0 + 1.8 * (sinA * sinA);

  const qbar = 0.5 * MODEL.rho * speed * speed;
  const lift = qbar * MODEL.area * CL;
  const drag = qbar * MODEL.area * CD;

  const qHat = (state.pitchRate * MODEL.chord) / (2 * speed);
  const cgOffsetMeters = state.cgOffset / 1000; // mm to meters

  // Pitching moment coefficient Cm = Cm_ac - CL * (CG ahead of AC / chord) + damping
  const Cm = MODEL.cmAC - CL * (cgOffsetMeters / MODEL.chord) + MODEL.cmQ * qHat;
  const moment = qbar * MODEL.area * MODEL.chord * Cm;

  return { speed, flightPathAngle, alpha, lift, drag, moment };
}

function updatePhysics(dt) {
  if (state.paused || state.landed) return;

  const aero = computeAerodynamics();
  const totalMass = MODEL.baseMass + (state.ballast / 1000);
  const gamma = aero.flightPathAngle;

  const forceX = -aero.drag * Math.cos(gamma) - aero.lift * Math.sin(gamma);
  const forceY = -aero.drag * Math.sin(gamma) + aero.lift * Math.cos(gamma) - (totalMass * MODEL.gravity);

  const ax = forceX / totalMass;
  const ay = forceY / totalMass;

  state.vx += ax * dt;
  state.vy += ay * dt;
  state.x += state.vx * dt;
  state.y += state.vy * dt;

  const angularAccel = aero.moment / MODEL.inertia;
  state.pitchRate += angularAccel * dt;
  state.pitch += state.pitchRate * dt;
  state.time += dt;

  state.lift = aero.lift;
  state.drag = aero.drag;
  state.moment = aero.moment;
  state.alpha = aero.alpha;

  // Ground check
  if (state.y <= 0) {
    state.y = 0;
    state.vy = 0;
    state.vx = 0;
    state.pitchRate = 0;
    state.landed = true;
    $('statusMsg').textContent = `Landing complete! Flight time: ${state.time.toFixed(2)}s | Range: ${state.x.toFixed(1)}m`;
    $('statusMsg').className = 'text-sm font-semibold text-amber-400 mt-1';
  }

  // Record history every 0.1s
  const lastH = state.history[state.history.length - 1];
  if (!lastH || state.time - lastH.time >= 0.1) {
    state.history.push({
      time: state.time,
      pitch: state.pitch * 180 / Math.PI,
      x: state.x,
      y: state.y
    });
    if (state.history.length > 400) state.history.shift();
  }

  updateTelemetryUI(aero);
}

function updateTelemetryUI(aero) {
  $('telePitch').textContent = (state.pitch * 180 / Math.PI).toFixed(1) + '°';
  $('teleAlt').textContent = Math.max(0, state.y).toFixed(2) + ' m';
  $('teleLift').textContent = state.lift.toFixed(2) + ' N';
  $('teleMoment').textContent = (state.moment >= 0 ? '+' : '') + state.moment.toFixed(3) + ' Nm';
  $('teleSpeed').textContent = aero.speed.toFixed(1) + ' m/s';
  $('teleAlpha').textContent = (aero.alpha * 180 / Math.PI).toFixed(1) + '°';

  $('hudTime').textContent = state.time.toFixed(2) + ' s';
  $('hudDist').textContent = state.x.toFixed(1) + ' m';
}

// Rendering
function drawAll() {
  drawMainVisualizer();
  drawPitchChart();
  drawTrajChart();
}

function drawMainVisualizer() {
  const rect = simCanvas.getBoundingClientRect();
  const w = rect.width;
  const h = rect.height;
  simCtx.clearRect(0, 0, w, h);

  // Background sky
  simCtx.fillStyle = '#0b0f19';
  simCtx.fillRect(0, 0, w, h);

  // Ground
  const groundY = h - 35;
  simCtx.fillStyle = '#1e293b';
  simCtx.fillRect(0, groundY, w, 35);
  simCtx.strokeStyle = '#38bdf8';
  simCtx.lineWidth = 2;
  simCtx.beginPath();
  simCtx.moveTo(0, groundY);
  simCtx.lineTo(w, groundY);
  simCtx.stroke();

  // Draw Trajectory Trail on canvas
  if (state.history.length > 1) {
    const maxX = Math.max(15, ...state.history.map(p => p.x));
    const maxY = Math.max(12, ...state.history.map(p => p.y));

    simCtx.strokeStyle = 'rgba(56, 189, 248, 0.6)';
    simCtx.lineWidth = 2;
    simCtx.beginPath();
    state.history.forEach((pt, i) => {
      const px = 20 + (pt.x / maxX) * (w - 40);
      const py = groundY - 10 - (pt.y / maxY) * (groundY - 30);
      if (i === 0) simCtx.moveTo(px, py);
      else simCtx.lineTo(px, py);
    });
    simCtx.stroke();
  }

  // Draw Aircraft Diamond Wing
  const cx = Math.min(180, w * 0.32);
  const cy = Math.min(groundY - 80, Math.max(90, h * 0.45));

  simCtx.save();
  simCtx.translate(cx, cy);
  simCtx.rotate(-state.pitch);

  const chord = 130;
  const span = 130;

  // Wing body fill
  simCtx.fillStyle = 'rgba(56, 189, 248, 0.15)';
  simCtx.strokeStyle = '#38bdf8';
  simCtx.lineWidth = 2;
  simCtx.beginPath();
  simCtx.moveTo(-chord / 2, 0);
  simCtx.lineTo(0, -span / 2);
  simCtx.lineTo(chord / 2, 0);
  simCtx.lineTo(0, span / 2);
  simCtx.closePath();
  simCtx.fill();
  simCtx.stroke();

  // Carbon fiber cross struts
  simCtx.strokeStyle = '#64748b';
  simCtx.lineWidth = 3;
  simCtx.beginPath();
  simCtx.moveTo(-chord / 2, 0);
  simCtx.lineTo(chord / 2, 0);
  simCtx.moveTo(0, -span / 2);
  simCtx.lineTo(0, span / 2);
  simCtx.stroke();

  // AC marker (1/4 MAC from leading edge)
  const acX = -chord / 2 + (chord * 0.25);
  simCtx.fillStyle = '#38bdf8';
  simCtx.beginPath();
  simCtx.arc(acX, 0, 5, 0, Math.PI * 2);
  simCtx.fill();
  simCtx.fillStyle = '#94a3b8';
  simCtx.font = '10px sans-serif';
  simCtx.fillText('AC', acX - 6, -10);

  // CG marker (shifted relative to AC)
  const cgX = acX - (state.cgOffset / 60) * (chord * 0.3);
  simCtx.fillStyle = '#f43f5e';
  simCtx.beginPath();
  simCtx.arc(cgX, 0, 6, 0, Math.PI * 2);
  simCtx.fill();
  simCtx.fillStyle = '#fb7185';
  simCtx.fillText('CG', cgX - 6, 20);

  // Ballast weight box near leading edge
  if (state.ballast > 0) {
    simCtx.fillStyle = '#fbbf24';
    simCtx.fillRect(-chord / 2 - 6, -5, 10, 10);
    simCtx.fillStyle = '#fef08a';
    simCtx.font = '9px sans-serif';
    simCtx.fillText(state.ballast + 'g', -chord / 2 - 24, 25);
  }

  simCtx.restore();
}

function drawPitchChart() {
  const rect = pitchCanvas.getBoundingClientRect();
  const w = rect.width, h = rect.height;
  pitchCtx.clearRect(0, 0, w, h);
  drawGridLines(pitchCtx, w, h);

  if (state.history.length < 2) return;
  const maxTime = Math.max(5, state.history[state.history.length - 1].time);
  const pitches = state.history.map(p => p.pitch);
  const minP = Math.min(-10, ...pitches);
  const maxP = Math.max(20, ...pitches);
  const range = Math.max(1, maxP - minP);

  pitchCtx.strokeStyle = '#22d3ee';
  pitchCtx.lineWidth = 2;
  pitchCtx.beginPath();
  state.history.forEach((pt, i) => {
    const x = (pt.time / maxTime) * w;
    const y = h - ((pt.pitch - minP) / range) * (h - 10) - 5;
    if (i === 0) pitchCtx.moveTo(x, y);
    else pitchCtx.lineTo(x, y);
  });
  pitchCtx.stroke();
}

function drawTrajChart() {
  const rect = trajCanvas.getBoundingClientRect();
  const w = rect.width, h = rect.height;
  trajCtx.clearRect(0, 0, w, h);
  drawGridLines(trajCtx, w, h);

  if (state.history.length < 2) return;
  const maxX = Math.max(10, ...state.history.map(p => p.x));
  const maxY = Math.max(12, ...state.history.map(p => p.y));

  trajCtx.strokeStyle = '#10b981';
  trajCtx.lineWidth = 2;
  trajCtx.beginPath();
  state.history.forEach((pt, i) => {
    const x = (pt.x / maxX) * w;
    const y = h - (pt.y / maxY) * (h - 10) - 5;
    if (i === 0) trajCtx.moveTo(x, y);
    else trajCtx.lineTo(x, y);
  });
  trajCtx.stroke();
}

function drawGridLines(ctx, w, h) {
  ctx.strokeStyle = '#1e293b';
  ctx.lineWidth = 1;
  for (let i = 1; i < 4; i++) {
    ctx.beginPath();
    ctx.moveTo(0, (h * i) / 4);
    ctx.lineTo(w, (h * i) / 4);
    ctx.stroke();
  }
}

// Main Animation & Fixed Timestep Loop
let lastTime = performance.now();
let accumulator = 0;

function loop(timestamp) {
  const frameTime = (timestamp - lastTime) / 1000;
  lastTime = timestamp;

  accumulator += Math.min(frameTime, 0.05);
  while (accumulator >= MODEL.dt) {
    updatePhysics(MODEL.dt);
    accumulator -= MODEL.dt;
  }

  drawAll();
  requestAnimationFrame(loop);
}

// Initialize on load
window.addEventListener('resize', () => {
  setupCanvasResolutions();
  drawAll();
});

setupCanvasResolutions();
readInputs();
resetSimulation();
requestAnimationFrame(loop);
</script>
