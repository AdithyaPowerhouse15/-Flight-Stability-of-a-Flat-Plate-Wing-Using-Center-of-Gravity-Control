<body class="min-h-screen">

<header class="bg-aerospace-800 border-b border-slate-700 p-5 flex flex-wrap justify-between gap-4">
  <div>
    <h1 class="text-xl font-bold text-white">Flat-Plate Wing Flight Stability Simulator</h1>
    <p class="text-xs text-slate-400 mt-1">Aerodynamics & CG Control | Square Diamond Configuration</p>
  </div>
  <div class="flex flex-wrap gap-2">
    <button onclick="setPreset('stable')" class="bg-emerald-700/40 text-emerald-300 border border-emerald-600 rounded-lg px-3 py-2 text-xs">Stable</button>
    <button onclick="setPreset('neutral')" class="bg-amber-700/40 text-amber-300 border border-amber-600 rounded-lg px-3 py-2 text-xs">Neutral</button>
    <button onclick="setPreset('unstable')" class="bg-rose-700/40 text-rose-300 border border-rose-600 rounded-lg px-3 py-2 text-xs">Unstable</button>
    <button onclick="resetSimulation()" class="bg-slate-700 rounded-lg px-3 py-2 text-xs">Reset</button>
  </div>
</header>

<main class="max-w-[1600px] mx-auto p-4 grid grid-cols-1 lg:grid-cols-12 gap-5">

<section class="lg:col-span-5 space-y-5">

<div class="panel">
  <div class="flex justify-between items-center mb-5">
    <h2 class="text-sm font-bold uppercase text-sky-400">Flight & Mass Parameters</h2>
    <span id="mode" class="text-xs rounded-full px-3 py-1 bg-emerald-500/20 text-emerald-300">Stable</span>
  </div>

  <div class="space-y-5">

    <div>
      <div class="flex justify-between text-xs mb-2">
        <label>Ballast Mass (added mass)</label>
        <b id="ballastVal" class="text-sky-400">200 g</b>
      </div>
      <input id="ballast" type="range" min="0" max="300" step="10" value="200">
      <div class="flex justify-between text-[10px] text-slate-500">
        <span>0 g</span><span>300 g</span>
      </div>
    </div>

    <div>
      <div class="flex justify-between text-xs mb-2">
        <label>CG Position Relative to AC</label>
        <b id="cgVal" class="text-sky-400">+35 mm</b>
      </div>
      <input id="cg" type="range" min="-30" max="60" step="1" value="35">
      <div class="flex justify-between text-[10px] text-slate-500">
        <span>-30 mm: Aft</span><span>0: AC</span><span>+60 mm: Forward</span>
      </div>
    </div>

    <div>
      <div class="flex justify-between text-xs mb-2">
        <label>Launch Angle of Attack</label>
        <b id="aoaVal" class="text-sky-400">5.0°</b>
      </div>
      <input id="aoa" type="range" min="-5" max="25" step="0.5" value="5">
    </div>

    <div>
      <div class="flex justify-between text-xs mb-2">
        <label>Initial Airspeed</label>
        <b id="speedVal" class="text-sky-400">12.0 m/s</b>
      </div>
      <input id="speed" type="range" min="5" max="25" step="0.5" value="12">
    </div>

  </div>

  <div class="grid grid-cols-2 gap-3 mt-6">
    <button onclick="triggerLaunch()" class="bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold rounded-xl py-3">▶ Launch</button>
    <button onclick="togglePause()" id="pauseBtn" class="bg-slate-700 hover:bg-slate-600 rounded-xl py-3">Pause</button>
  </div>
</div>

<div class="panel">
  <h3 class="text-xs uppercase font-bold text-slate-400 mb-3">Live Telemetry</h3>
  <div class="grid grid-cols-2 gap-3">
    <div class="metric">
      <span class="text-xs text-slate-400">Pitch Angle</span>
      <div id="telePitch" class="text-xl font-mono text-white">5.0°</div>
    </div>
    <div class="metric">
      <span class="text-xs text-slate-400">Altitude</span>
      <div id="teleAlt" class="text-xl font-mono text-sky-400">10.0 m</div>
    </div>
    <div class="metric">
      <span class="text-xs text-slate-400">Lift Force</span>
      <div id="teleLift" class="text-xl font-mono text-emerald-400">0 N</div>
    </div>
    <div class="metric">
      <span class="text-xs text-slate-400">Pitch Moment</span>
      <div id="teleMoment" class="text-xl font-mono text-amber-400">0 Nm</div>
    </div>
    <div class="metric">
      <span class="text-xs text-slate-400">Airspeed</span>
      <div id="teleSpeed" class="text-xl font-mono text-white">12 m/s</div>
    </div>
    <div class="metric">
      <span class="text-xs text-slate-400">Angle of Attack</span>
      <div id="teleAlpha" class="text-xl font-mono text-white">5.0°</div>
    </div>
  </div>
</div>

<div class="panel">
  <h3 class="text-xs uppercase font-bold text-sky-400 mb-3">Aerodynamic Theory</h3>
  <p id="theory" class="text-xs text-slate-300 leading-relaxed">
    A CG ahead of the aerodynamic center produces a restoring nose-down moment when the angle of attack increases, providing positive longitudinal static stability in this simplified model.
  </p>
  <p class="text-[10px] text-slate-500 mt-3">
    Educational model: coefficients, inertia, and geometry are approximate. Actual aircraft performance requires experimental or validated aerodynamic data.
  </p>
</div>

</section>

<section class="lg:col-span-7 space-y-5">

<div class="panel">
  <div class="flex justify-between items-center mb-3">
    <h3 class="text-xs uppercase font-bold text-slate-400">Square Diamond Wing Visualizer</h3>
    <span class="text-xs text-sky-400">AC ● &nbsp; <span class="text-rose-400">CG ●</span></span>
  </div>
  <div class="relative h-[380px] bg-aerospace-900 rounded-xl overflow-hidden border border-slate-700">
    <canvas id="simCanvas"></canvas>
    <div class="absolute top-3 left-3 bg-slate-900/80 rounded-lg p-2 text-xs font-mono">
      Time: <span id="hudTime" class="text-sky-400">0.00 s</span>
      <br>
      Range: <span id="hudDist" class="text-emerald-400">0.0 m</span>
    </div>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
  <div class="panel">
    <h3 class="text-xs uppercase font-bold text-slate-400 mb-3">Pitch Angle vs Time</h3>
    <div class="h-36 bg-slate-950 rounded-lg overflow-hidden">
      <canvas id="pitchChart"></canvas>
    </div>
  </div>
  <div class="panel">
    <h3 class="text-xs uppercase font-bold text-slate-400 mb-3">Altitude vs Range</h3>
    <div class="h-36 bg-slate-950 rounded-lg overflow-hidden">
      <canvas id="trajChart"></canvas>
    </div>
  </div>
</div>

<div class="panel">
  <h3 class="text-xs uppercase font-bold text-slate-400 mb-3">Simulation Status</h3>
  <p id="status" class="text-sm text-emerald-400">Ready for launch</p>
  <p class="text-xs text-slate-500 mt-2">
    Flight-path angle and body pitch are calculated separately. Aerodynamic angle of attack is their difference.
  </p>
</div>

</section>
</main>

<footer class="text-center text-xs text-slate-500 border-t border-slate-800 py-5">
  Aircraft Design Student Project | Flat-Plate Wing Aerodynamics & Longitudinal Stability
</footer>

<script>
'use strict';

/* =========================================
   AIRCRAFT MODEL PARAMETERS
========================================= */

const MODEL = {
  rho: 1.225,       // Air density, kg/m^3
  gravity: 9.81,    // m/s^2
  area: 0.98,       // Reference wing area, m^2
  chord: 0.94,      // Mean aerodynamic chord, m
  baseMass: 0.345,  // Base aircraft mass, kg
  inertia: 0.08,    // Approximate pitch inertia, kg m^2
  cmAC: 0.0,        // Assumed zero AC pitching moment coefficient
  cmQ: -8.0,        // Approximate pitch-rate damping derivative
  cd0: 0.08,        // Simplified zero-alpha drag coefficient
  dt: 1 / 120       // Fixed simulation step, seconds
};

/* =========================================
   SIMULATION STATE
========================================= */

const state = {
  ballast: 200,
  cgOffset: 35,
  aoa: 5,
  speed: 12,

  x: 0,
  y: 10,
  vx: 12,
  vy: 0,

  pitch: 5 * Math.PI / 180,
  pitchRate: 0,

  time: 0,
  paused: false,
  launched: false,
  landed: false,

  lift: 0,
  drag: 0,
  moment: 0,
  alpha: 0,

  history: []
};

const $ = id => document.getElementById(id);

const simCanvas = $('simCanvas');
const pitchCanvas = $('pitchChart');
const trajCanvas = $('trajChart');

const simCtx = simCanvas.getContext('2d');
const pitchCtx = pitchCanvas.getContext('2d');
const trajCtx = trajCanvas.getContext('2d');

/* =========================================
   CANVAS RESIZING
========================================= */

function resizeCanvas(canvas) {
  const rect = canvas.getBoundingClientRect();
  const dpr = Math.min(window.devicePixelRatio || 1, 2);

  canvas.width = Math.max(1, Math.round(rect.width * dpr));
  canvas.height = Math.max(1, Math.round(rect.height * dpr));

  const ctx = canvas.getContext('2d');
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

  return { w: rect.width, h: rect.height };
}

function resizeAll() {
  resizeCanvas(simCanvas);
  resizeCanvas(pitchCanvas);
  resizeCanvas(trajCanvas);
  draw();
}

window.addEventListener('resize', resizeAll);

/* =========================================
   INPUTS AND PARAMETERS
========================================= */

function readInputs() {
  state.ballast = Number($('ballast').value);
  state.cgOffset = Number($('cg').value);
  state.aoa = Number($('aoa').value);
  state.speed = Number($('speed').value);

  $('ballastVal').textContent = state.ballast + ' g';
  $('cgVal').textContent =
    (state.cgOffset > 0 ? '+' : '') +
    state.cgOffset + ' mm';

  $('aoaVal').textContent = state.aoa.toFixed(1) + '°';
  $('speedVal').textContent = state.speed.toFixed(1) + ' m/s';

  updateMode();
  updateTelemetry();
}

['ballast', 'cg', 'aoa', 'speed'].forEach(id => {
  $(id).addEventListener('input', readInputs);
});

function updateMode() {
  const badge = $('mode');
  const theory = $('theory');

  if (state.cgOffset > 5) {
    badge.textContent = 'Stable CG';
    badge.className =
      'text-xs rounded-full px-3 py-1 bg-emerald-500/20 text-emerald-300';

    theory.textContent =
      'The CG is ahead of the aerodynamic center. In this model, an increase in angle of attack produces a restoring nose-down pitching moment. This corresponds to positive longitudinal static stability, assuming the other aerodynamic derivatives are appropriate.';
  } else if (state.cgOffset < -5) {
    badge.textContent = 'Unstable CG';
    badge.className =
      'text-xs rounded-full px-3 py-1 bg-rose-500/20 text-rose-300';

    theory.textContent =
      'The CG is behind the aerodynamic center. In this model, an increase in angle of attack produces a destabilizing nose-up pitching moment. Pitch disturbances can grow instead of returning toward equilibrium.';
  } else {
    badge.textContent = 'Near Neutral';
    badge.className =
      'text-xs rounded-full px-3 py-1 bg-amber-500/20 text-amber-300';

    theory.textContent =
      'The CG is near the aerodynamic center. The simplified static restoring contribution is small. Pitch behavior depends more strongly on the assumed aerodynamic moment derivatives and damping.';
  }
}

/* =========================================
   PRESETS
========================================= */

function setPreset(mode) {
  if (mode === 'stable') {
    $('ballast').value = 200;
    $('cg').value = 35;
    $('aoa').value = 5;
    $('speed').value = 12;
  } else if (mode === 'neutral') {
    $('ballast').value = 100;
    $('cg').value = 0;
    $('aoa').value = 5;
    $('speed').value = 12;
  } else {
    $('ballast').value = 0;
    $('cg').value = -15;
    $('aoa').value = 5;
    $('speed').value = 12;
  }

  readInputs();
  resetSimulation();
}

/* =========================================
   AERODYNAMIC MODEL
========================================= */

/*
  Simplified flat-plate model.

  CL = 1.8 sin(alpha) cos(alpha)

  CD = CD0 + 1.8 sin^2(alpha)

  Cm = CmAC - CL * (CG ahead of AC / chord)
       + CmQ * nondimensional pitch rate

  Positive CG offset means forward of AC.

  Positive pitching moment means nose-up.
*/

function aerodynamicModel() {
  const vx = state.vx;
  const vy = state.vy;

  const speed = Math.max(0.1, Math.hypot(vx, vy));
  const flightPath = Math.atan2(vy, vx);

  // Angle of attack = body pitch - flight path angle
  const alpha = state.pitch - flightPath;

  const sinA = Math.sin(alpha);
  const cosA = Math.cos(alpha);

  // Flat-plate approximation
  const CL = 1.8 * sinA * cosA;
  const CD = MODEL.cd0 + 1.8 * sinA * sinA;

  const qbar = 0.5 * MODEL.rho * speed * speed;

  const lift = qbar * MODEL.area * CL;
  const drag = qbar * MODEL.area * CD;

  // Nondimensional pitch rate
  const qHat = state.pitchRate * MODEL.chord / (2 * speed);

  // Forward CG produces a negative static restoring contribution
  const cgAhead = state.cgOffset / 1000;

  const Cm =
    MODEL.cmAC -
    CL * (cgAhead / MODEL.chord) +
    MODEL.cmQ * qHat;

  const moment = qbar * MODEL.area * MODEL.chord * Cm;

  return {
    speed,
    flightPath,
    alpha,
    CL,
    CD,
    lift,
    drag,
    moment,
    qbar
  };
}

/* =========================================
   FLIGHT DYNAMICS
========================================= */

function updatePhysics(dt) {
  if (!state.launched || state.paused || state.landed) return;

  const aero = aerodynamicModel();

  const mass = MODEL.baseMass + state.ballast / 1000;

  // Aerodynamic forces in world coordinates
  const gamma = aero.flightPath;

  const forceX =
    -aero.drag * Math.cos(gamma) -
    aero.lift * Math.sin(gamma);

  const forceY =
    -aero.drag * Math.sin(gamma) +
    aero.lift * Math.cos(gamma) -
    mass * MODEL.gravity;

  const ax = forceX / mass;
  const ay = forceY / mass;

  // Translational motion
  state.vx += ax * dt;
  state.vy += ay * dt;

  state.x += state.vx * dt;
  state.y += state.vy * dt;

  // Rotational motion: Iyy * theta_ddot = pitching moment
  const angularAcceleration = aero.moment / MODEL.inertia;

  state.pitchRate += angularAcceleration * dt;
  state.pitch += state.pitchRate * dt;

  state.time += dt;

  state.lift = aero.lift;
  state.drag = aero.drag;
  state.moment = aero.moment;
  state.alpha = aero.alpha;

  // Ground contact
  if (state.y <= 0) {
    state.y = 0;
    state.vy = 0;
    state.landed = true;
    $('status').textContent =
      'Ground contact | Flight time: ' + state.time.toFixed(2) + ' s';
    $('status').className = 'text-sm text-amber-400';
  }

  // Stop runaway numerical values
  if (
    !Number.isFinite(state.pitch) ||
    !Number.isFinite(state.x) ||
    !Number.isFinite(state.y) ||
    Math.abs(state.pitch) > 100 * Math.PI
  ) {
    state.landed = true;
    $('status').textContent = 'Simulation stopped: numerical limit reached';
    $('status').className = 'text-sm text-rose-400';
  }

  // Record graph data
  if (
    state.history.length === 0 ||
    state.time - state.history[state.history.length - 1].time >= 0.1
  ) {
    state.history.push({
      time: state.time,
      pitch: state.pitch * 180 / Math.PI,
      x: state.x,
      y: state.y
    });

    if (state.history.length > 300) {
      state.history.shift();
    }
  }

  updateTelemetry();
}

/* =========================================
   TELEMETRY
========================================= */

function updateTelemetry() {
  const aero = aerodynamicModel();

  $('telePitch').textContent =
    (state.pitch * 180 / Math.PI).toFixed(1) + '°';

  $('teleAlt').textContent =
    Math.max(0, state.y).toFixed(2) + ' m';

  $('teleLift').textContent =
    state.lift.toFixed(2) + ' N';

  $('teleMoment').textContent =
    (state.moment >= 0 ? '+' : '') +
    state.moment.toFixed(3) + ' Nm';

  $('teleSpeed').textContent =
    aero.speed.toFixed(2) + ' m/s';

  $('teleAlpha').textContent =
    (state.alpha * 180 / Math.PI).toFixed(2) + '°';

  $('hudTime').textContent = state.time.toFixed(2) + ' s';
  $('hudDist').textContent = state.x.toFixed(2) + ' m';
}

/* =========================================
   RESET AND LAUNCH
========================================= */

function resetSimulation() {
  readInputs();

  state.x = 0;
  state.y = 10;

  // Launch velocity is initially horizontal.
  // Body pitch is set to the selected launch AoA.
  // This gives the selected initial aerodynamic angle of attack.
  state.vx = state.speed;
  state.vy = 0;

  state.pitch = state.aoa * Math.PI / 180;
  state.pitchRate = 0;

  state.time = 0;
  state.lift = 0;
  state.drag = 0;
  state.moment = 0;
  state.alpha = state.pitch;

  state.history = [{
    time: 0,
    pitch: state.aoa,
    x: 0,
    y: 10
  }];

  state.launched = true;
  state.landed = false;

  $('status').textContent = 'Simulation running';
  $('status').className = 'text-sm text-emerald-400';

  updateTelemetry();
  draw();
}

function triggerLaunch() {
  state.paused = false;
  $('pauseBtn').textContent = 'Pause';
  resetSimulation();
}

function togglePause() {
  if (!state.launched || state.landed) return;

  state.paused = !state.paused;

  $('pauseBtn').textContent =
    state.paused ? 'Resume' : 'Pause';

  $('status').textContent =
    state.paused ? 'Simulation paused' : 'Simulation running';
}

/* =========================================
   MAIN CANVAS DRAWING
========================================= */

function draw() {
  drawFlight();
  drawPitchChart();
  drawTrajectoryChart();
}

function drawFlight() {
  const { w, h } = resizeDimensions(simCanvas);
  simCtx.clearRect(0, 0, w, h);

  // Sky
  simCtx.fillStyle = '#0b0f19';
  simCtx.fillRect(0, 0, w, h);

  // Horizon and ground
  const ground = h - 35;

  simCtx.fillStyle = '#1e293b';
  simCtx.fillRect(0, ground, w, 35);

  simCtx.strokeStyle = '#38bdf8';
  simCtx.lineWidth = 2;
  simCtx.beginPath();
  simCtx.moveTo(0, ground);
  simCtx.lineTo(w, ground);
  simCtx.stroke();

  // Scale the flight history to fit the visible area
  if (state.history.length > 1) {
    const maxX = Math.max(10, ...state.history.map(p => p.x));
    const maxY = Math.max(12, ...state.history.map(p => p.y));

    simCtx.strokeStyle = 'rgba(56,189,248,0.75)';
    simCtx.lineWidth = 2;
    simCtx.beginPath();

    state.history.forEach((p, i) => {
      const px = 15 + (p.x / maxX) * (w - 30);
      const py = ground - 5 - (p.y / maxY) * (ground - 15);

      if (i === 0) simCtx.moveTo(px, py);
      else simCtx.lineTo(px, py);
    });

    simCtx.stroke();
  }

  // Glider visualization
  const cx = Math.min(160, w * 0.3);
  const cy = Math.min(ground - 80, Math.max(90, h * 0.48));

  simCtx.save();
  simCtx.translate(cx, cy);
  simCtx.rotate(-state.pitch);

  const chord = 140;
  const span = 140;

  // Wing body
  simCtx.fillStyle = 'rgba(56,189,248,0.17)';
  simCtx.strokeStyle = '#38bdf8';
  simCtx.lineWidth = 2;

  simCtx.beginPath();
  simCtx.moveTo(-chord / 2, 0);
  simCtx.lineTo(0, -span / 2);
  simCtx.lineTo(chord / 2, 0);
  simCtx.lineTo(0, span / 2);
  simCtx.closePath();
  simCtx.fill();
  simCtx.stroke();

  // Structural supports
  simCtx.strokeStyle = '#64748b';
  simCtx.lineWidth = 3;

  simCtx.beginPath();
  simCtx.moveTo(-chord / 2, 0);
  simCtx.lineTo(chord / 2, 0);
  simCtx.moveTo(0, -span / 2);
  simCtx.lineTo(0, span / 2);
  simCtx.stroke();

  // AC marker
  const acX = -chord / 2 + chord * 0.25;

  simCtx.fillStyle = '#38bdf8';
  simCtx.beginPath();
  simCtx.arc(acX, 0, 5, 0, Math.PI * 2);
  simCtx.fill();

  simCtx.fillStyle = '#94a3b8';
  simCtx.font = '11px Arial';
  simCtx.fillText('AC', acX - 10, -12);

  // CG marker
  const cgX = acX - (state.cgOffset / 60) * (chord * 0.3);

  simCtx.fillStyle = '#f43f5e';
  simCtx.beginPath();
  simCtx.arc(cgX, 0, 6, 0, Math.PI * 2);
  simCtx.fill();

  simCtx.fillStyle = '#fb7185';
  simCtx.fillText('CG', cgX - 10, 19);

  // Ballast marker (illustrative)
  if (state.ballast > 0) {
    simCtx.fillStyle = '#fbbf24';
    simCtx.fillRect(-chord / 2 - 7, -5, 10, 10);
    simCtx.fillText(
      state.ballast + ' g',
      -chord / 2 - 25,
      32
    );
  }

  simCtx.restore();
}

function resizeDimensions(canvas) {
  const rect = canvas.getBoundingClientRect();
  return { w: rect.width, h: rect.height };
}

/* =========================================
   GRAPH DRAWING
========================================= */

function drawPitchChart() {
  const { w, h } = resizeDimensions(pitchCanvas);
  pitchCtx.clearRect(0, 0, w, h);

  drawGrid(pitchCtx, w, h);

  if (state.history.length < 2) return;

  const maxTime = Math.max(
    5,
    state.history[state.history.length - 1].time
  );

  const pitchValues = state.history.map(p => p.pitch);
  const minP = Math.min(-10, ...pitchValues);
  const maxP = Math.max(20, ...pitchValues);
  const range = Math.max(1, maxP - minP);

  pitchCtx.strokeStyle = '#22d3ee';
  pitchCtx.lineWidth = 2;
  pitchCtx.beginPath();

  state.history.forEach((p, i) => {
    const x = (p.time / maxTime) * w;
    const y = h - ((p.pitch - minP) / range) * (h - 10) - 5;

    if (i === 0) pitchCtx.moveTo(x, y);
    else pitchCtx.lineTo(x, y);
  });

  pitchCtx.stroke();
}

function drawTrajectoryChart() {
  const { w, h } = resizeDimensions(trajCanvas);
  trajCtx.clearRect(0, 0, w, h);

  drawGrid(trajCtx, w, h);

  if (state.history.length < 2) return;

  const maxX = Math.max(5, ...state.history.map(p => p.x));
  const maxY = Math.max(12, ...state.history.map(p => p.y));

  trajCtx.strokeStyle = '#10b981';
  trajCtx.lineWidth = 2;
  trajCtx.beginPath();

  state.history.forEach((p, i) => {
    const x = (p.x / maxX) * w;
    const y = h - (p.y / maxY) * (h - 10) - 5;

    if (i === 0) trajCtx.moveTo(x, y);
    else trajCtx.lineTo(x, y);
  });

  trajCtx.stroke();
}

function drawGrid(ctx, w, h) {
  ctx.strokeStyle = '#1e293b';
  ctx.lineWidth = 1;

  for (let i = 1; i < 4; i++) {
    ctx.beginPath();
    ctx.moveTo(0, h * i / 4);
    ctx.lineTo(w, h * i / 4);
    ctx.stroke();
  }
}

/* =========================================
   FIXED TIMESTEP ANIMATION
========================================= */

let lastTimestamp = 0;
let accumulator = 0;

function animationLoop(timestamp) {
  if (!lastTimestamp) lastTimestamp = timestamp;

  let frameTime = (timestamp - lastTimestamp) / 1000;
  lastTimestamp = timestamp;

  // Avoid excessive catch-up after inactive tabs
  frameTime = Math.min(frameTime, 0.05);

  if (!state.paused && state.launched && !state.landed) {
    accumulator += frameTime;

    while (accumulator >= MODEL.dt) {
      updatePhysics(MODEL.dt);
      accumulator -= MODEL.dt;
    }
  }

  draw();
  requestAnimationFrame(animationLoop);
}

/* =========================================
   INITIALIZATION
========================================= */

readInputs();
resizeAll();
resetSimulation();
requestAnimationFrame(animationLoop);

</script>
