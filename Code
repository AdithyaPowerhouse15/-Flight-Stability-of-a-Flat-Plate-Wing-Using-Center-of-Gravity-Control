<!DOCTYPE html>
<html lang="en" class="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Flat-Plate Wing Flight Stability Simulator</title>
<script src="https://cdn.tailwindcss.com"></script>
<script>
tailwind.config = {
  darkMode: 'class',
  theme: {
    extend: {
      colors: {
        aerospace: {
          900: '#0b0f19',
          800: '#111827',
          700: '#1f2937',
          accent: '#38bdf8'
        }
      }
